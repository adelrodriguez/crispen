{
  "extends": "adamantite/typescript",
  "compilerOptions": {
    "lib": ["ESNext"],
    "target": "ESNext",
    "module": "Preserve",
    "moduleDetection": "force",
    "jsx": "react-jsx",
    "allowJs": true,
    "allowImportingTsExtensions": true,
    "moduleResolution": "bundler",
    "noEmit": true,
    "verbatimModuleSyntax": true,
    "types": ["bun"],
    "paths": {
      "crispen": ["./src/index.ts"],
      "crispen/react": ["./src/integrations/react/index.ts"],
      "crispen/vite": ["./src/adapters/vite/index.ts"],
      "crispen/next": ["./src/adapters/next/index.ts"]
    }
  },
  "include": ["src", "scripts", "e2e", "*.config.ts"],
  "exclude": ["node_modules", "dist", ".packref"]
}
