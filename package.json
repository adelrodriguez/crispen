{
  "name": "crispen",
  "version": "0.0.0",
  "description": "Keep your deployments fresh",
  "keywords": [
    "deployment",
    "react-hook",
    "stale-client",
    "version-skew",
    "vite-plugin"
  ],
  "homepage": "https://github.com/adelrodriguez/crispen#readme",
  "bugs": {
    "url": "https://github.com/adelrodriguez/crispen/issues"
  },
  "license": "MIT",
  "author": "Adel Rodríguez",
  "repository": {
    "type": "git",
    "url": "https://github.com/adelrodriguez/crispen.git"
  },
  "workspaces": [
    "examples/nextjs",
    "examples/vite-react"
  ],
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/integrations/react/index.d.ts",
      "import": "./dist/integrations/react/index.js"
    },
    "./vite": {
      "types": "./dist/adapters/vite/index.d.ts",
      "import": "./dist/adapters/vite/index.js"
    },
    "./next": {
      "types": "./dist/adapters/next/index.d.ts",
      "import": "./dist/adapters/next/index.js"
    }
  },
  "scripts": {
    "analyze": "adamantite analyze",
    "build": "bunup",
    "build:examples": "bun scripts/build-examples.ts",
    "bump:deps": "bun update --interactive",
    "check": "adamantite check",
    "dev": "bunup --watch",
    "fix": "adamantite fix",
    "format": "adamantite format",
    "lab": "bun scripts/lab.ts",
    "release": "changeset publish",
    "test": "bun test src",
    "test:coverage": "bun test --coverage src",
    "test:e2e": "playwright test",
    "test:exports": "bun run build && bun scripts/verify-exports.ts",
    "test:watch": "bun test --watch src",
    "version": "changeset version && bun run format"
  },
  "devDependencies": {
    "@changesets/cli": "2.31.1",
    "@happy-dom/global-registrator": "20.11.2",
    "@playwright/test": "1.62.1",
    "@testing-library/react": "16.3.2",
    "@types/bun": "1.3.14",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.3",
    "adamantite": "0.34.1",
    "bunup": "0.16.32",
    "knip": "6.32.0",
    "next": "16.3.0",
    "oxfmt": "0.62.0",
    "oxlint": "1.77.0",
    "oxlint-tsgolint": "7.0.2001",
    "react-dom": "19.2.8",
    "typescript": "7.0.2"
  },
  "peerDependencies": {
    "next": ">=15",
    "react": ">=18",
    "vite": ">=5"
  },
  "peerDependenciesMeta": {
    "next": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "vite": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "bun@1.3.14"
}
