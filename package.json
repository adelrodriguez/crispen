{
  "name": "crispen",
  "version": "0.0.0",
  "description": "Keep your deployments fresh",
  "keywords": [
    "bun",
    "library",
    "template"
  ],
  "homepage": "https://github.com/adelrodriguez/crispen#readme",
  "bugs": {
    "url": "https://github.com/adelrodriguez/crispen/issues"
  },
  "license": "MIT",
  "author": "Adel Rodríguez",
  "repository": {
    "type": "git",
    "url": "https://github.com/adelrodriguez/crispen.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "module": "src/index.ts",
  "scripts": {
    "analyze": "adamantite analyze",
    "build": "bunup",
    "bump:deps": "bun update --interactive",
    "check": "adamantite check",
    "dev": "bunup --watch",
    "fix": "adamantite fix",
    "format": "adamantite format",
    "release": "changeset publish",
    "test": "bun test",
    "test:coverage": "bun test --coverage",
    "test:watch": "bun test --watch",
    "version": "changeset version && bun run format"
  },
  "devDependencies": {
    "@changesets/cli": "2.31.1",
    "@types/bun": "1.3.14",
    "adamantite": "0.34.1",
    "bunup": "0.16.32",
    "knip": "6.29.0",
    "oxfmt": "0.60.0",
    "oxlint": "1.75.0",
    "oxlint-tsgolint": "7.0.2001",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "bun@1.3.14"
}
