{
  "name": "crispen",
  "version": "0.0.0",
  "description": "Keep your deployments fresh",
  "keywords": [
    "deployment",
    "react-hook",
    "stale-client",
    "version-skew",
    "vite-plugin"
  ],
  "homepage": "https://github.com/adelrodriguez/crispen#readme",
  "bugs": {
    "url": "https://github.com/adelrodriguez/crispen/issues"
  },
  "license": "MIT",
  "author": "Adel Rodríguez",
  "repository": {
    "type": "git",
    "url": "https://github.com/adelrodriguez/crispen.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/integrations/react/index.d.ts",
      "import": "./dist/integrations/react/index.js"
    },
    "./vite": {
      "types": "./dist/adapters/vite/index.d.ts",
      "import": "./dist/adapters/vite/index.js"
    },
    "./next": {
      "types": "./dist/adapters/next/index.d.ts",
      "import": "./dist/adapters/next/index.js"
    }
  },
  "scripts": {
    "analyze": "adamantite analyze",
    "build": "tsdown",
    "build:examples": "node scripts/build-examples.ts",
    "build:verify": "node scripts/verify-package-contract.ts",
    "bump:deps": "pnpm update --interactive",
    "check": "adamantite check",
    "dev": "tsdown --watch",
    "fix": "adamantite fix",
    "lab": "node scripts/lab.ts",
    "release": "changeset publish",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:watch": "vitest",
    "version": "changeset version && adamantite fix --only format"
  },
  "devDependencies": {
    "@changesets/cli": "2.31.1",
    "@happy-dom/global-registrator": "20.11.2",
    "@playwright/test": "1.62.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "24.13.3",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.3",
    "@vitest/coverage-v8": "4.1.11",
    "adamantite": "0.43.0",
    "knip": "6.39.0",
    "next": "16.3.0",
    "oxfmt": "0.71.0",
    "oxlint": "1.86.0",
    "oxlint-tsgolint": "7.0.2003",
    "react-dom": "19.2.8",
    "sherif": "1.13.0",
    "tsdown": "0.22.14",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  },
  "peerDependencies": {
    "next": ">=15",
    "react": ">=18",
    "vite": ">=5"
  },
  "peerDependenciesMeta": {
    "next": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "vite": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.6.0",
  "sherif": {
    "ignoreRule": [
      "root-package-private-field"
    ]
  }
}
